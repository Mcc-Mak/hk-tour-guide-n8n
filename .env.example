# n8n Basic Auth
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# n8n Network
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_SECURE_COOKIE=false
N8N_API_KEY=your-n8n-api-key-here
# 啟用被預設封鎖的節點（如 Execute Command）：設為空陣列 [] 以解除封鎖
NODES_EXCLUDE=[]
WEBHOOK_URL=http://0.0.0.0:45678/webhook

# HKO LLM Provider (LiteLLM Proxy — OpenAI-compatible)
HKO_API_KEY=your-hko-api-key-here
HKO_LLM_BASE_URL=https://litellm.services.hko.gov.hk
HKO_LLM_PRIMARY=zai-org/GLM-5.2-FP8
HKO_LLM_FALLBACK=deepseek-ai/DeepSeek-V4-Flash-0731-Coding
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8000

# GitHub
GITHUB_TOKEN=ghp-your-token-here

# CrewAI
CREWAI_VERBOSE=true

# Search API (for archival research)
SEARCH_API_KEY=your-search-api-key
